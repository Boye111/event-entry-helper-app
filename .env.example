# Postgres connection string. Supabase: Connect -> Transaction pooler (port 6543). Neon: pooled URL.
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Setup password: asked for ONCE on the login page to create the organiser account (username + password).
ADMIN_PASSWORD=
# Long random string (32+ chars) for signing session cookies
SESSION_SECRET=
# Optional. Only for a custom domain (e.g. https://tundebisi.com). On Vercel the *.vercel.app address is
# detected automatically, so leave this out. (Older setups used NEXT_PUBLIC_SITE_URL; it still works.)
SITE_URL=
# Optional: timezone used to show event and check-in times (default Africa/Lagos)
NEXT_PUBLIC_EVENT_TIMEZONE=
# Only for `npm run test:checkin`: an organiser account to log in with
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=
